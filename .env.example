# Application
AIBI_ENVIRONMENT=development

# LLM
AIBI_OPENAI_API_KEY=
AIBI_NL_QUERY_MODEL=gpt-4.1-mini

# Database
AIBI_DB_HOST=localhost
AIBI_DB_PORT=5432
AIBI_DB_NAME=ai_business_intelligence
AIBI_DB_USER=aibi_admin
AIBI_DB_PASSWORD=changeme

AIBI_DB_ECHO=false
AIBI_DB_POOL_SIZE=5
AIBI_DB_MAX_OVERFLOW=10
AIBI_DB_CONNECT_TIMEOUT=5
AIBI_DB_STATEMENT_TIMEOUT=30
AIBI_DB_POOL_TIMEOUT=10
AIBI_DB_SLOW_QUERY_THRESHOLD_MS=500

# Rate limiting
AIBI_RATE_LIMIT_REQUESTS=30
AIBI_RATE_LIMIT_WINDOW_SECONDS=60
AIBI_RATE_LIMIT_BURST=10

# Analytics limits
AIBI_MAX_QUERIES_PER_REQUEST=5
AIBI_MAX_ROWS=1000

# Authentication
AIBI_AUTH_ENABLED=true
AIBI_JWT_SECRET_KEY=development-only-change-me-rotate-this-key
AIBI_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30